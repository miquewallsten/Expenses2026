# ── Required ──────────────────────────────────────────────────────────────────
# A strong random string — generate with: openssl rand -hex 32
SECRET_KEY=

# PostgreSQL password for the app user
POSTGRES_PASSWORD=changeme

# ── AI / Ollama ──────────────────────────────────────────────────────────────
# Point to Ollama. On OrbStack/Docker Desktop, host.docker.internal resolves
# to the host machine; adjust if you run a dedicated Ollama container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-v3.1:671b-cloud
OLLAMA_NUM_CTX=32768

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ── Frontend ──────────────────────────────────────────────────────────────────
# Publicly reachable URL of the backend API (baked in at frontend build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
